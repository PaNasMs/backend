#!/usr/bin/python3
import json,os,subprocess
from pathlib import Path
if os.geteuid()!=0: raise SystemExit('Run as root')
folder=Path('/etc/panasms-cooling'); folder.mkdir(mode=0o755,exist_ok=True)
config=folder/'config.json'
if not config.exists():
    config.write_text(json.dumps({'profile':'balanced','cpuProfile':'balanced','sampleSeconds':60,
        'hardwareMode':'none','controlGPIO':27,'tachGPIO':None,'disks':[]},indent=2)+'\n')
    config.chmod(0o644)
subprocess.run(['systemctl','enable','--now','panasms-cooling.service'],check=True)
print('Cooling controller enabled. New installations do not control disk-bay GPIO until configured in Settings.')
