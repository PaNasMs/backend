[Unit]
Description=PaNasMs independent disk cooling controller
After=local-fs.target

[Service]
Type=notify
ExecStart=/usr/bin/python3 /usr/lib/panasms-cooling/controller.py
ExecStopPost=/usr/bin/python3 /usr/lib/panasms-cooling/controller.py --failsafe
Restart=always
RestartSec=2
WatchdogSec=15
RuntimeDirectory=panasms-cooling
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=restart
UMask=0022
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/run/panasms-cooling /sys/devices /sys/kernel/config

[Install]
WantedBy=multi-user.target
