[Unit]
Description=PaNasMs independent disk cooling controller
After=local-fs.target

[Service]
Type=notify
ExecStart=/usr/bin/python3 /usr/lib/panasms-cooling/controller.py
ExecStopPost=/usr/bin/pinctrl set 27 op dh
Restart=always
RestartSec=2
WatchdogSec=15
RuntimeDirectory=panasms-cooling
RuntimeDirectoryMode=0755
UMask=0022
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/run/panasms-cooling /sys/devices/virtual/thermal/thermal_zone0

[Install]
WantedBy=multi-user.target
