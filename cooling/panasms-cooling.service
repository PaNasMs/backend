[Unit]
Description=PaNasMs independent disk cooling controller
After=local-fs.target

[Service]
Type=notify
ExecStart=/usr/lib/panasms-cooling/panasms-cooling
ExecStopPost=/usr/lib/panasms-cooling/panasms-cooling --failsafe
Restart=always
RestartSec=2
WatchdogSec=15
RuntimeDirectory=panasms-cooling
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=restart
StateDirectory=panasms-cooling
StateDirectoryMode=0755
UMask=0022
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/run/panasms-cooling /sys/devices /sys/kernel/config -/sys/kernel/debug/pinctrl

[Install]
WantedBy=multi-user.target
