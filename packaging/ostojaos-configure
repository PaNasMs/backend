#!/bin/sh
set -eu
[ "$(id -u)" = 0 ] || { echo 'Run as root' >&2; exit 1; }
[ "$#" = 0 ] || { echo 'Usage: ostojaos-configure' >&2; exit 1; }
python3 -c 'import grp,pwd,os; gid=grp.getgrnam("sudo").gr_gid; assert any(u.pw_uid != 0 and gid in os.getgrouplist(u.pw_name,u.pw_gid) for u in pwd.getpwall()), "No existing sudo users found"'
udevadm control --reload-rules
systemctl enable ostojaos-network-sharing.service ostojaos-network-recovery.service ostojaos-agent.service ostojaos-core.service
systemctl restart ostojaos-network-sharing.service
systemctl restart ostojaos-agent.service ostojaos-core.service
echo 'OstojaOS: http://ostojaos.local/ (port 80). Authentication policy is read from /etc/ostojaos/ostojaos.env.'
