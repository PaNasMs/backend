[Unit]
Description=OstojaOS API and web interface
After=network.target ostojaos-agent.service
Requires=ostojaos-agent.service

[Service]
User=ostojaos
Group=ostojaos
EnvironmentFile=/etc/ostojaos/ostojaos.env
ExecStart=/usr/lib/ostojaos/ostojaos-core -listen :80 -allow-http
Restart=on-failure
RestartSec=3
StateDirectory=ostojaos
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
