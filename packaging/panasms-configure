#!/bin/sh
set -eu
[ "$(id -u)" = 0 ] || { echo 'Run as root' >&2; exit 1; }
if [ "$#" != 0 ]; then
 [ "$#" = 2 ] && [ "$1" = --port ] || { echo 'Usage: panasms-configure [--port PORT]' >&2; exit 1; }
fi
/usr/lib/panasms/panasms-system-helper check-admin
port=$(/usr/lib/panasms/panasms-system-helper web-access --configure "$@")
udevadm control --reload-rules
systemctl enable panasms-network-sharing.service panasms-network-recovery.service panasms-agent.service panasms-core.service
systemctl restart panasms-network-sharing.service
systemctl restart panasms-agent.service panasms-core.service
printf 'PaNasMs: http://panasms.local:%s/ . Authentication policy is read from /etc/panasms/panasms.env.\n' "$port"
