#!/bin/sh
set -eu
[ "$(id -u)" = 0 ] || { echo 'Run as root' >&2; exit 1; }
if [ "$#" != 0 ]; then
 [ "$#" = 2 ] && [ "$1" = --port ] || { echo 'Usage: panasms-configure [--port PORT]' >&2; exit 1; }
fi
if [ "${PANASMS_MAINTENANCE:-}" != 1 ]; then
 exec /usr/sbin/panasms-maintenance /usr/sbin/panasms-configure "$@"
fi
/usr/lib/panasms/panasms-system-helper check-admin
port=$(/usr/lib/panasms/panasms-system-helper web-access --configure "$@")
udevadm control --reload-rules
systemctl enable panasms-network-sharing.service panasms-network-recovery.service panasms-agent.service panasms-core.service
systemctl restart panasms-network-sharing.service
systemctl restart panasms-agent.service panasms-core.service
# Modules kept from a removed installation are still registered as enabled.
python3 -B /usr/lib/panasms/management/module_manager.py --resume || true
scheme=http
[ ! -f /etc/panasms/https.enabled ] || scheme=https
printf 'PaNasMs: %s://panasms.local:%s/ . Authentication policy is read from /etc/panasms/panasms.env.\n' "$scheme" "$port"
if [ -t 1 ]; then
 /usr/lib/panasms/panasms-system-helper network-access credentials
fi
