[Unit]
Description=PaNasMs HDD software idle controller
After=local-fs.target
ConditionPathExists=/etc/panasms/disk-sleep.json

[Service]
Type=oneshot
ExecStart=/usr/lib/panasms/panasms-system-helper disk-sleep once
RuntimeDirectory=panasms-disk-sleep
RuntimeDirectoryPreserve=yes
TimeoutStartSec=120
