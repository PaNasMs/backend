[Unit]
Description=Restore unconfirmed PaNasMs Wi-Fi changes after reboot
After=NetworkManager.service systemd-networkd.service
Before=panasms-agent.service panasms-core.service

[Service]
Type=oneshot
ExecStart=/usr/lib/panasms/panasms-system-helper network-services recover
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
