[Unit]
Description=PaNasMs network sharing recovery and uplink routing
After=NetworkManager.service systemd-networkd.service network-online.target panasms-network-recovery.service
Wants=network-online.target
Before=panasms-agent.service

[Service]
Type=simple
ExecStart=/usr/lib/panasms/panasms-system-helper network-services run
Restart=on-failure
RestartSec=5s
UMask=0077

[Install]
WantedBy=multi-user.target
