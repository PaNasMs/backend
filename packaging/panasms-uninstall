#!/usr/bin/python3
import argparse
import grp
import json
import os
import pwd
import subprocess
import sys
from pathlib import Path

parser = argparse.ArgumentParser(description='Remove only the PaNasMs prototype; user storage is preserved.')
mode = sys.argv[1] if len(sys.argv) == 2 else '--plan'
if mode not in ('--plan', '--remove', '--purge'):
    parser.error('use --plan, --remove or --purge')
owned = ['/etc/panasms/panasms.env', '/etc/panasms/web.env', '/var/lib/panasms-agent/web-access.json', '/etc/panasms/tls.key', '/etc/panasms/tls.crt', '/etc/panasms/https.enabled',
         '/var/lib/panasms-agent/jobs.db', '/var/lib/panasms-agent/jobs.db-wal', '/var/lib/panasms-agent/jobs.db-shm', '/var/lib/panasms-agent/jobs.db.initialized',
         '/var/lib/panasms/state.db', '/var/lib/panasms/state.db-wal', '/var/lib/panasms/state.db-shm', '/var/lib/panasms/state.db.initialized']
# Dependencies that keep user storage and shares working after the panel is gone.
# apt would otherwise offer them for autoremove.
tools = ['mdadm', 'parted', 'e2fsprogs', 'dosfstools', 'exfatprogs', 'xfsprogs', 'btrfs-progs', 'cryptsetup-bin',
         'cifs-utils', 'nfs-common', 'nfs-kernel-server', 'samba', 'samba-common-bin', 'smbclient', 'smartmontools',
         'hdparm', 'rsync', 'acl', 'network-manager']
print('PaNasMs services, binaries and UI will be removed; the PAM service file /etc/pam.d/panasms is removed on purge.')
print('Module services are stopped and disabled; purge also removes uploaded archives, module code and registry. User files remain.')
print('Shared folders published by the panel are unpublished (their SMB/NFS definitions are removed); the folders and files remain.')
print('Storage and sharing tools stay installed and are marked as manually installed so that apt autoremove keeps them:', ', '.join(tools))
print('Purge additionally removes:', ', '.join(owned))
print('Purge keeps per-user module data under /var/lib/panasms-cloud-sync, the installer record in /var/lib/panasms-installer and the key protecting stored cloud authorizations in /var/lib/panasms; delete them by hand if the panel will not be reinstalled.')
print('The independent panasms-cooling package/service is retained to keep the disks cooled.')
print('Linux account expiry, login shells and /etc/ssh/sshd_config.d/60-panasms-users.conf are retained as OS access policy.')
print('LUKS keys and crypttab entries are retained to preserve access to encrypted volumes.')
print('RAID recovery files are retained; finish conversions before removing the panel.')
print('Linux user data, RAID, filesystems, mounts, other packages and system journal are preserved.')
sys.stdout.flush()
if mode == '--plan':
    subprocess.run(['dpkg-query', '-L', 'panasms-prototype'], check=False)
    sys.exit(0)
if os.geteuid() != 0:
    sys.exit('Run as root.')
for parent in ['/etc/panasms', '/var/lib/panasms', '/var/lib/panasms-installer', '/var/lib/panasms-agent']:
    if Path(parent).is_symlink():
        sys.exit('Refusing operation through symlink: ' + parent)
marker = Path('/var/lib/panasms-installer/created-user').is_file()
try:
    account = pwd.getpwnam('panasms')
except KeyError:
    account = None
if account and (account.pw_gecos != 'PaNasMs prototype service' or account.pw_dir != '/nonexistent'):
    sys.exit('Service account identity differs from installer record; inspect manually.')
automatic = subprocess.run(['apt-mark', 'showauto'] + tools, capture_output=True, text=True, check=False).stdout.split()
if automatic:
    subprocess.run(['apt-mark', 'manual'] + automatic, check=True)
subprocess.run(['apt-get', '-y', 'purge' if mode == '--purge' else 'remove', 'panasms-prototype'], check=True)
if mode == '--remove':
    print('Panel configuration, databases and the module registry are kept for a later reinstall.')
    print('This tool is removed with the package; to delete the kept state later, run: sudo apt-get purge panasms-prototype')
    sys.exit(0)
remaining = [p for p in ['/etc/panasms', '/var/lib/panasms', '/var/lib/panasms-agent'] if Path(p).exists()]
if remaining:
    print('Unmanaged files remain; inspect these directories:', *remaining, sep='\n')
    sys.exit(2)
if account and marker:
    mounted = json.loads(subprocess.check_output(['findmnt', '--json', '--list', '--output', 'TARGET,FSTYPE']))['filesystems']
    allowed_fs = {'ext2', 'ext3', 'ext4', 'btrfs', 'xfs', 'zfs', 'f2fs', 'tmpfs', 'overlay'}
    candidates = [m['target'] for m in mounted if m['fstype'] in allowed_fs and not m['target'].startswith(('/proc', '/sys', '/dev'))]
    leftovers = []
    for target in sorted(set(candidates)):
        result = subprocess.run(['find', target, '-xdev', '-uid', str(account.pw_uid), '-print', '-quit'], capture_output=True, text=True)
        if result.returncode:
            sys.exit('Could not verify ownership; service account retained. Check mounts and retry account cleanup manually.')
        if result.stdout.strip():
            leftovers.append(result.stdout.strip())
    if leftovers:
        print('Service account retained; it still owns:', *leftovers, sep='\n')
        sys.exit(2)
    subprocess.run(['userdel', 'panasms'], check=True)
    try:
        grp.getgrnam('panasms')
    except KeyError:
        pass
    else:
        subprocess.run(['groupdel', 'panasms'], check=True)
for name in ['created-user', 'generated-files', 'hardware.json']:
    Path('/var/lib/panasms-installer', name).unlink(missing_ok=True)
try:
    Path('/var/lib/panasms-installer').rmdir()
except FileNotFoundError:
    pass
print('PaNasMs purge complete. System journal entries remain under the OS retention policy.')
