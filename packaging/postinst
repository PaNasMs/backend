#!/bin/sh
set -eu
case "${1:-}" in
 configure)
  if ! getent passwd ostojaos >/dev/null; then
   adduser --system --group --home /nonexistent --no-create-home --gecos 'OstojaOS prototype service' ostojaos
   install -d -m 0750 /var/lib/ostojaos-installer
   touch /var/lib/ostojaos-installer/created-user
  else
   entry=$(getent passwd ostojaos)
   case "$entry" in *':OstojaOS prototype service:/nonexistent:/usr/sbin/nologin') ;; *) echo 'Existing ostojaos account is not owned by this installer' >&2; exit 1;; esac
  fi
  install -d -o root -g ostojaos -m 0755 /var/lib/ostojaos-modules
  install -d -o root -g ostojaos -m 0750 /etc/ostojaos
  install -d -o ostojaos -g ostojaos -m 0700 /var/lib/ostojaos
  install -d -o root -g root -m 0750 /var/lib/ostojaos-installer
  if [ ! -e /etc/ostojaos/ostojaos.env ]; then
   printf 'OSTOJAOS_AUTH_MODE=sudo\n' > /etc/ostojaos/ostojaos.env
   chmod 0640 /etc/ostojaos/ostojaos.env
   chown root:ostojaos /etc/ostojaos/ostojaos.env
  fi
  printf '%s\n' /etc/ostojaos/ostojaos.env /etc/ostojaos/tls.key /etc/ostojaos/tls.crt /var/lib/ostojaos/state.db /var/lib/ostojaos/state.db-wal /var/lib/ostojaos/state.db-shm > /var/lib/ostojaos-installer/generated-files
  systemctl daemon-reload
  echo 'Installed, not started. Run sudo ostojaos-configure to enable HTTP on port 80.'
 ;;
esac
