#!/bin/sh
set -eu
case "${1:-}" in
 configure)
  if ! getent passwd panasms >/dev/null; then
   adduser --system --group --home /nonexistent --no-create-home --gecos 'PaNasMs prototype service' panasms
   install -d -m 0750 /var/lib/panasms-installer
   touch /var/lib/panasms-installer/created-user
  else
   entry=$(getent passwd panasms | sed 's/:PaNasMs prototype service,*:/:PaNasMs prototype service:/')
   case "$entry" in *':PaNasMs prototype service:/nonexistent:/usr/sbin/nologin') ;; *) echo 'Existing panasms account is not owned by this installer' >&2; exit 1;; esac
  fi
  usermod --comment 'PaNasMs prototype service' panasms
  install -d -o root -g panasms -m 0755 /var/lib/panasms-modules
  install -d -o root -g panasms -m 0750 /etc/panasms
  install -d -o panasms -g panasms -m 0700 /var/lib/panasms
  install -d -o root -g root -m 0750 /var/lib/panasms-installer
  if [ ! -e /etc/panasms/panasms.env ]; then
   printf 'PANASMS_AUTH_MODE=sudo\n' > /etc/panasms/panasms.env
   chmod 0640 /etc/panasms/panasms.env
   chown root:panasms /etc/panasms/panasms.env
  fi
  printf '%s\n' /etc/panasms/panasms.env /etc/panasms/web.env /etc/panasms/tls.key /etc/panasms/tls.crt /etc/panasms/https.enabled /var/lib/panasms/state.db /var/lib/panasms/state.db-wal /var/lib/panasms/state.db-shm > /var/lib/panasms-installer/generated-files
  report=$(mktemp /var/lib/panasms-installer/hardware.XXXXXX)
  if /usr/sbin/panasms-inspect-hardware > "$report"; then
   mv "$report" /var/lib/panasms-installer/hardware.json
  else
   rm -f "$report"
   echo 'Hardware inspection unavailable; the panel will detect capabilities at runtime.' >&2
  fi
  python3 /usr/lib/panasms/sharing-install.py
  python3 /usr/lib/panasms/management/sharing.py --republish >/dev/null || echo 'Shared folders kept from the previous installation were not republished; use Restore in Shared folders.' >&2
  systemd-tmpfiles --create /usr/lib/tmpfiles.d/panasms.conf
  getent group users >/dev/null || groupadd --system users
  systemctl daemon-reload
  udevadm control --reload-rules
  udevadm trigger --action=add --subsystem-match=usb --attr-match=idVendor=0bda --attr-match=idProduct=8152
  /usr/lib/panasms/panasms-system-helper network-access initialize || echo 'Direct network access setup incomplete; review Network settings.' >&2
  systemctl enable panasms-volume-access.service
  systemctl restart panasms-volume-access.service
  systemctl enable panasms-network-access.service
  systemctl restart panasms-network-access.service
  systemctl enable panasms-networkd-recovery.service
  systemctl enable panasms-raid-recovery.service
  systemctl enable panasms-update-recover.service
  systemctl enable --now panasms-update-check.timer
  systemctl enable --now panasms-sharing.timer
  if [ -f /etc/panasms/disk-sleep.json ]; then
   systemctl enable --now panasms-disk-sleep.timer
  fi
  # The public installer configures and starts the panel itself right after this script.
  if [ "${PANASMS_INSTALLER:-}" != 1 ]; then
   echo 'Installed, not started. Run sudo panasms-configure to enable HTTP on port 80.'
  fi
 ;;
esac
