#!/bin/sh
set -eu
systemctl daemon-reload || true
if [ "${1:-}" = remove ] || [ "${1:-}" = purge ]; then systemctl try-restart avahi-daemon.service || true; fi
udevadm control --reload-rules || true
if [ "${1:-}" = purge ]; then
 for dir in /etc/panasms /var/lib/panasms /var/lib/panasms-installer /var/lib/panasms-agent; do
  if [ -L "$dir" ]; then echo "Refusing purge through symlink: $dir" >&2; exit 1; fi
 done
 for file in /etc/panasms/panasms.env /etc/panasms/web.env /etc/panasms/tls.key /etc/panasms/tls.crt /var/lib/panasms/state.db /var/lib/panasms/state.db-wal /var/lib/panasms/state.db-shm /var/lib/panasms/state.db.initialized /var/lib/panasms-agent/web-access.lock /var/lib/panasms-agent/sharing.lock /var/lib/panasms-agent/web-access.json /var/lib/panasms-agent/jobs.db /var/lib/panasms-agent/jobs.db-wal /var/lib/panasms-agent/jobs.db-shm /var/lib/panasms-agent/jobs.db.initialized; do
  rm -f -- "$file"
 done
 python3 - <<'CLEAN'
from pathlib import Path
import os
import re
import json
import shutil
for folder in ('/var/lib/panasms-updates', '/var/lib/panasms-agent/module-uploads'):
    path=Path(folder)
    if path.is_dir() and not path.is_symlink() and path.stat().st_uid==0:
        shutil.rmtree(path)
# A publisher hold fences a failed repository enrollment. It outlives the
# package so a reinstall keeps refusing that publisher until it is reviewed.
hold=re.compile(r'\.source-add-hold-[a-zA-Z0-9_-]{1,64}\.[0-9a-f]{32}')
modules=Path('/var/lib/panasms-modules')
if modules.is_dir() and not modules.is_symlink() and modules.stat().st_uid==os.geteuid():
    for child in modules.iterdir():
        if hold.fullmatch(child.name) and child.is_file() and not child.is_symlink():continue
        if child.is_dir() and not child.is_symlink():shutil.rmtree(child)
        else:child.unlink()
    try:modules.rmdir()
    except OSError:pass
for unit in Path('/etc/systemd/system').glob('panasms-module-*.service'):
    if re.fullmatch(r'panasms-module-[a-z][a-z0-9-]{1,39}\.service',unit.name) and not unit.is_symlink():
        unit.unlink()
state=Path('/run/panasms-filesystems')
if state.is_dir() and not state.is_symlink():
    for p in state.iterdir():
        if p.is_file() and not p.is_symlink() and p.stat().st_uid==0 and re.fullmatch(r'[a-zA-Z0-9_-]+\.(json|lock|tmp)',p.name):p.unlink()
    try:state.rmdir()
    except OSError:pass
cache=Path('/usr/lib/panasms/management/__pycache__')
if cache.is_dir() and not cache.is_symlink():
    for p in cache.glob('*.pyc'):
        if p.is_file() and not p.is_symlink() and p.stat().st_uid==0:p.unlink()
    try:cache.rmdir()
    except OSError:pass
for folder, names in (('/var/lib/panasms-agent/network-access', ('config.json', 'lock')), ('/var/lib/panasms-agent/network-sharing', ('pending.json', 'groups.json', 'boot')), ('/var/lib/panasms-agent/network-wifi', ('pending.json',)), ('/run/panasms-network', ('change.json', 'lock'))):
    directory=Path(folder)
    if directory.is_dir() and not directory.is_symlink():
        for name in names:
            path=directory/name
            if path.is_file() and not path.is_symlink() and path.stat().st_uid==0:path.unlink()
        try:directory.rmdir()
        except OSError:pass
for folder in ('/usr/lib/panasms/management','/usr/lib/panasms'):
    try:Path(folder).rmdir()
    except OSError:pass
sources=Path('/etc/panasms/module-sources.json')
keys=Path('/etc/panasms/module-keys')
# Revoke every third-party publisher key, including orphans without a source
# row: a reinstall must not trust a publisher nobody reviewed again. Official
# panasms-* keys and unrelated operator files stay. Purge runs as root, so the
# key owner is the purging user.
if keys.is_dir() and not keys.is_symlink():
    for key in keys.iterdir():
        if re.fullmatch(r'[a-zA-Z0-9_-]{1,64}\.pem', key.name) and not key.name.startswith('panasms-'):
            if key.is_file() and not key.is_symlink() and key.stat().st_uid==os.geteuid():key.unlink()
sources.unlink(missing_ok=True)
Path('/etc/panasms/updates.json').unlink(missing_ok=True)
Path('/etc/panasms/disk-sleep.json').unlink(missing_ok=True)
Path('/etc/panasms/oled.json').unlink(missing_ok=True)
Path('/run/lock/panasms-oled-config.lock').unlink(missing_ok=True)
Path('/etc/panasms/sharing.json').unlink(missing_ok=True)
Path('/var/lib/panasms-agent/sharing-transaction.json').unlink(missing_ok=True)
root=Path('/var/lib/panasms-agent/backups')
if root.exists() and not root.is_symlink():
    for p in root.iterdir():
        if p.is_file() and not p.is_symlink() and p.stat().st_uid==0 and re.fullmatch(r'[A-Za-z0-9_.-]+\.\d+',p.name):p.unlink()
    try:root.rmdir()
    except OSError:pass
for timer in Path('/etc/systemd/system').glob('panasms-smart-*.timer'):
    import subprocess
    if re.fullmatch(r'panasms-smart-[0-9a-f]{16}(?:-short|-long)?\.timer',timer.name):
        subprocess.run(['systemctl','disable','--now',timer.name],check=False)
        timer.unlink(missing_ok=True);timer.with_suffix('.service').unlink(missing_ok=True)
CLEAN
 systemctl daemon-reload || true
if [ "${1:-}" = remove ] || [ "${1:-}" = purge ]; then systemctl try-restart avahi-daemon.service || true; fi
 rmdir /var/lib/panasms-agent 2>/dev/null || true
 rmdir /etc/panasms /var/lib/panasms 2>/dev/null || true
 if [ -f /var/lib/panasms-installer/created-user ]; then
  echo 'Dedicated locked service account panasms retained for a later reinstall. To remove it, check that no files are owned by it (find / -xdev -user panasms) and run: sudo deluser --system panasms'
 fi
 echo 'User data, Linux users, RAID, mounts and system journal preserved.'
fi
