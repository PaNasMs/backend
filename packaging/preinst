#!/bin/sh
set -eu
if [ "${1:-}" = upgrade ] && [ "${PANASMS_MAINTENANCE:-}" != 1 ]; then
 echo 'Use Settings > System updates, or panasms-maintenance apt-get install ./package.deb. Package replacement requires exclusive maintenance.' >&2
 exit 1
fi
for journal in /var/lib/panasms-agent/sharing-transaction.json /var/lib/panasms-agent/sharing-legacy-nfs-transaction.json; do
 if [ -e "$journal" ] || [ -L "$journal" ]; then
  echo 'Recover pending sharing transactions with the installed version before package changes.' >&2
  exit 1
 fi
done
for legacy in /etc/pinas /var/lib/pinas /var/lib/pinas-agent /var/lib/pinas-modules /etc/pinas-cooling /usr/lib/pinas /usr/lib/pinas-cooling /etc/ostojaos /var/lib/ostojaos /var/lib/ostojaos-agent /var/lib/ostojaos-modules /etc/ostojaos-cooling /usr/lib/ostojaos /usr/lib/ostojaos-cooling; do
 if [ -e "$legacy" ] || [ -L "$legacy" ]; then
  echo "Existing legacy NAS installation found at $legacy. Migrate its configuration and data before installing PaNasMs; nothing has been changed." >&2
  exit 1
 fi
done
if [ "${1:-}" = install ] && [ ! -f /var/lib/panasms-installer/generated-files ]; then
 for path in /etc/panasms /var/lib/panasms /etc/pam.d/panasms; do
  if [ -e "$path" ] || [ -L "$path" ]; then
   echo "Unmanaged path already exists: $path. Inspect before installing PaNasMs." >&2
   exit 1
  fi
 done
 if getent passwd panasms >/dev/null; then
  echo 'Unmanaged panasms account already exists; installation stopped.' >&2
  exit 1
 fi
fi
python3 - "${1:-}" "${2:-}" <<'MODE'
import json, os, stat, subprocess, sys, tempfile
from pathlib import Path
root = Path('/var/lib/panasms-installer')
if root.is_symlink() or any(parent.is_symlink() for parent in root.parents):
    raise SystemExit('Refusing sharing package state through a symbolic link')
root.mkdir(mode=0o750, parents=True, exist_ok=True)
info = root.stat()
if info.st_uid != 0 or info.st_mode & 0o022:
    raise SystemExit('Untrusted sharing package state directory')
record = root / 'sharing-package-state.json'
compat = Path('/usr/lib/panasms/management/sharing_compat.py')
if (record.exists() or record.is_symlink()) and not compat.exists() and not compat.is_symlink():
    declared = subprocess.check_output(['dpkg-query', '-L', 'panasms-prototype'], text=True).splitlines()
    if str(compat) in declared:
        raise SystemExit('The installed sharing compatibility helper is missing; repair it before package changes')
    current = subprocess.check_output(['dpkg-query', '-W', '-f=${Version}', 'panasms-prototype'], text=True).strip()
    fd = os.open(record, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd) as stream:
        record_info = os.fstat(stream.fileno())
        if not stat.S_ISREG(record_info.st_mode) or record_info.st_uid != 0 or record_info.st_nlink != 1 or record_info.st_mode & 0o022:
            raise SystemExit('Untrusted sharing package transition record')
        value = json.load(stream)
    if not sys.argv[2] or current != sys.argv[2] or value.get('schema') != 1 or value.get('targetVersion') != current or type(value.get('timerActive')) is not bool:
        raise SystemExit('The sharing package transition requires recovery before replacement')
    guard = Path('/var/lib/panasms-agent/sharing-restore.json')
    if guard.exists() or guard.is_symlink():
        raise SystemExit('Complete the sharing rollback before replacing its package')
    record.unlink()
    fd = os.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)
marker = root / 'sharing-package-install'
if marker.is_symlink():
    raise SystemExit('Refusing sharing install marker through a symbolic link')
if sys.argv[1] == 'install':
    with tempfile.NamedTemporaryFile(dir=root, delete=False) as stream:
        temporary = Path(stream.name)
        try:
            stream.write(b'install\n')
            stream.flush()
            os.fsync(stream.fileno())
            temporary.replace(marker)
        finally:
            temporary.unlink(missing_ok=True)
else:
    marker.unlink(missing_ok=True)
fd = os.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
try:
    os.fsync(fd)
finally:
    os.close(fd)
MODE
target='@PANASMS_PACKAGE_VERSION@'
dpkg --validate-version "$target"
case "${1:-}" in
 upgrade)
  if [ ! -f /usr/lib/panasms/management/sharing_compat.py ]; then
   echo 'Install the compatibility update in System updates before continuing.' >&2
   exit 1
  fi
  if [ -e /var/lib/panasms-agent/sharing-restore.json ] || [ -L /var/lib/panasms-agent/sharing-restore.json ]; then
   python3 /usr/lib/panasms/management/sharing_compat.py rollback-install "$target"
  else
   python3 /usr/lib/panasms/management/sharing_compat.py prepare-activation "$target"
  fi
 ;;
 install)
  if [ -n "${2:-}" ]; then
   python3 - "$target" "$2" <<'REINSTALL'
@PANASMS_REINSTALL_PREFLIGHT@
REINSTALL
   exit 0
  fi
  python3 - "$target" <<'ACTIVATION'
import json, os, secrets, stat, sys, tempfile
from pathlib import Path
root = Path('/var/lib/panasms-installer')
for directory in reversed((root, *root.parents)):
    if directory.is_symlink():
        raise SystemExit('Sharing configuration cannot be trusted. Ask an administrator to check its ownership and permissions.')
    if directory.exists():
        info = directory.stat()
        if not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
            raise SystemExit('Sharing configuration cannot be trusted. Ask an administrator to check its ownership and permissions.')
if root.exists() and any(path.name not in ('sharing-package-install', 'sharing-activation-v1.json') for path in root.iterdir()):
    raise SystemExit('Previous setup records remain after package removal. Preserve them and ask an administrator to complete recovery before a fresh installation.')
files = {path: {'exists': False} for path in ('/etc/panasms/sharing.json', '/etc/samba/panasms-shares.conf', '/etc/exports.d/panasms-shares.exports', '/etc/exports.d/panasms.exports')}
for name in (*files, '/var/lib/panasms-agent/sharing-transaction.json', '/var/lib/panasms-agent/sharing-legacy-nfs-transaction.json', '/var/lib/panasms-agent/sharing-restore.json'):
    path = Path(name)
    if path.exists() or path.is_symlink() or any(parent.is_symlink() for parent in path.parents):
        raise SystemExit('Install the compatibility update in System updates before continuing.')
root.mkdir(mode=0o750, exist_ok=True)
existing = root / 'sharing-activation-v1.json'
if existing.exists() or existing.is_symlink():
    fd = os.open(existing, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd) as stream:
        info = os.fstat(stream.fileno())
        if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_nlink != 1 or stat.S_IMODE(info.st_mode) != 0o600:
            raise SystemExit('Sharing setup is incomplete. Finish the system update before continuing.')
        value = json.load(stream)
    nonce = value.get('nonce', '')
    if set(value) != {'schema', 'targetVersion', 'nonce', 'source', 'files'} or value['schema'] != 1 or value['targetVersion'] != sys.argv[1] or value['source'] != {'fresh': True} or value['files'] != files or not isinstance(nonce, str) or len(nonce) != 32 or any(char not in '0123456789abcdef' for char in nonce):
        raise SystemExit('Sharing setup is incomplete. Finish the system update before continuing.')
    raise SystemExit(0)
ticket = {'schema': 1, 'targetVersion': sys.argv[1], 'nonce': secrets.token_hex(16), 'source': {'fresh': True}, 'files': files}
with tempfile.NamedTemporaryFile(dir=root, delete=False) as stream:
    temporary = Path(stream.name)
    try:
        stream.write(json.dumps(ticket, sort_keys=True).encode())
        stream.flush()
        os.fsync(stream.fileno())
        temporary.replace(root / 'sharing-activation-v1.json')
    finally:
        temporary.unlink(missing_ok=True)
fd = os.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
try:
    os.fsync(fd)
finally:
    os.close(fd)
ACTIVATION
 ;;
esac
