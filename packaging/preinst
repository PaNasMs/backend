#!/bin/sh
set -eu
if [ "${1:-}" = upgrade ] && [ "${PANASMS_MAINTENANCE:-}" != 1 ]; then
 echo 'Use Settings > System updates, or panasms-maintenance apt-get install ./package.deb. Package replacement requires exclusive maintenance.' >&2
 exit 1
fi
for journal in /var/lib/panasms-agent/sharing-transaction.json /var/lib/panasms-agent/sharing-legacy-nfs-transaction.json; do
 if [ -e "$journal" ] || [ -L "$journal" ]; then
  echo 'Recover pending sharing transactions with the installed version before package changes.' >&2
  exit 1
 fi
done
for legacy in /etc/pinas /var/lib/pinas /var/lib/pinas-agent /var/lib/pinas-modules /etc/pinas-cooling /usr/lib/pinas /usr/lib/pinas-cooling /etc/ostojaos /var/lib/ostojaos /var/lib/ostojaos-agent /var/lib/ostojaos-modules /etc/ostojaos-cooling /usr/lib/ostojaos /usr/lib/ostojaos-cooling; do
 if [ -e "$legacy" ] || [ -L "$legacy" ]; then
  echo "Existing legacy NAS installation found at $legacy. Migrate its configuration and data before installing PaNasMs; nothing has been changed." >&2
  exit 1
 fi
done
if [ "${1:-}" = install ] && [ ! -f /var/lib/panasms-installer/generated-files ]; then
 for path in /etc/panasms /var/lib/panasms /etc/pam.d/panasms; do
  if [ -e "$path" ] || [ -L "$path" ]; then
   echo "Unmanaged path already exists: $path. Inspect before installing PaNasMs." >&2
   exit 1
  fi
 done
 if getent passwd panasms >/dev/null; then
  echo 'Unmanaged panasms account already exists; installation stopped.' >&2
  exit 1
 fi
fi
python3 - "${1:-}" <<'MODE'
import os, sys, tempfile
from pathlib import Path
root = Path('/var/lib/panasms-installer')
if root.is_symlink():
    raise SystemExit('Refusing sharing package state through a symbolic link')
root.mkdir(mode=0o750, parents=True, exist_ok=True)
info = root.stat()
if info.st_uid != 0 or info.st_mode & 0o022:
    raise SystemExit('Untrusted sharing package state directory')
marker = root / 'sharing-package-install'
if marker.is_symlink():
    raise SystemExit('Refusing sharing install marker through a symbolic link')
if sys.argv[1] == 'install':
    with tempfile.NamedTemporaryFile(dir=root, delete=False) as stream:
        temporary = Path(stream.name)
        try:
            stream.write(b'install\n')
            stream.flush()
            os.fsync(stream.fileno())
            temporary.replace(marker)
        finally:
            temporary.unlink(missing_ok=True)
else:
    marker.unlink(missing_ok=True)
fd = os.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
try:
    os.fsync(fd)
finally:
    os.close(fd)
MODE
