#!/bin/sh
set -eu
case "${1:-}" in remove|upgrade|deconfigure)
 python3 - <<'CHECK'
import sqlite3, json, os
from pathlib import Path
update=Path('/var/lib/panasms-updates/state.json')
if update.exists():
    s=json.loads(update.read_text())
    if s.get('phase') in ('queued','checking','downloading','preparing','backing-up','installing','verifying','rolling-back','recovery-required') and os.environ.get('PANASMS_UPDATE_TRANSACTION') != s.get('id'):
        raise SystemExit('A PaNasMs update transaction is active.')
for path in ('/run/panasms-network/change.json', '/var/lib/panasms-agent/network-wifi/pending.json', '/var/lib/panasms-agent/network-sharing/pending.json'):
    state=Path(path)
    if state.exists() and json.loads(state.read_text()).get('status') in ('applying','pending'):
        raise SystemExit('Confirm or roll back pending network changes before package changes.')
web=Path('/var/lib/panasms-agent/web-access.json')
if web.exists() and json.loads(web.read_text()).get('phase') in ('scheduled','applying'):
    raise SystemExit('Wait for the HTTP port change to finish before package changes.')
p=Path('/var/lib/panasms-agent/jobs.db')
if p.exists():
    with sqlite3.connect(str(p)) as db:
        if db.execute("SELECT count(*) FROM jobs WHERE status IN ('queued','running')").fetchone()[0]:
            raise SystemExit('PaNasMs has active operations. Wait for completion or cancel queued tasks before package changes.')
CHECK
 systemctl stop 'panasms-fs-check@*.service' || true
 systemctl stop panasms-core.service panasms-agent.service
 systemctl stop panasms-sharing.timer panasms-sharing.service || true
 if [ "$1" = remove ]; then
  systemctl disable --now panasms-update-check.timer panasms-update-recover.service || true
  systemctl disable panasms-sharing.timer || true
  python3 /usr/lib/panasms/management/sharing.py --remove
  python3 /usr/lib/panasms/sharing-install.py --remove
  systemctl stop panasms-network-sharing.service || true
  if [ -f /var/lib/panasms-agent/network-sharing/groups.json ]; then
   python3 /usr/lib/panasms/management/network_sharing.py --remove
  fi
  python3 /usr/lib/panasms/management/wifi.py --remove
  systemctl disable panasms-network-sharing.service || true
  systemctl stop 'panasms-wifi-rollback-*.timer' panasms-network-recovery.service || true
  systemctl disable panasms-network-recovery.service || true
  systemctl stop 'panasms-module-*.service' || true
  systemctl disable 'panasms-module-*.service' || true
  systemctl stop 'panasms-smart-*.timer' || true
  systemctl disable 'panasms-smart-*.timer' || true
  systemctl stop panasms-disk-sleep.timer panasms-disk-sleep.service || true
  systemctl disable panasms-disk-sleep.timer || true
  python3 /usr/lib/panasms/management/disk_sleep.py --disable || true
  systemctl disable panasms-core.service panasms-agent.service
 fi
 ;;
esac
